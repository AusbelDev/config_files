{
  "general": {
    "previewFeatures": true
  },
  "mcpServers": {
    "kimAI": {
      "command": "uv",
      "args": [
        "run",
        "-m",
        "kimai.server"
      ],
      "cwd": "/home/ausbel/mcp-kimai/"
    }
  },
  "model": "Gemini 3.8 Flash (High)",
  "permissions": {
    "allow": [
      "mcp(KimAI/*)",
