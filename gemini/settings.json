  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "statusLine": {
    "type": "command",
    "command": "python3 /home/ausbel/.antigravity/status.py"
  },
  "trustedWorkspaces": [
    "/home/ausbel",
    "/home/ausbel/config_files",
    "/home/ausbel/projects/mcp-kimai",
    "/home/ausbel/config_files/terminal",
    "/home/ausbel/qmk_firmware/keyboards/sofle/keymaps"
  ],
  "ui": {
    "theme": "Atom One",
    "footer": {
      "hideContextPercentage": false
    },
    "showMemoryUsage": true,
    "showLineNumbers": true
  }
